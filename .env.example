# URL и publishable key публичные по задумке Supabase (защита идёт через RLS).
# service_role ключ сюда никогда не клади.
EXPO_PUBLIC_SUPABASE_URL=https://btohzbmjtfxxxwyajpar.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_nQ3pDKM8tzLFI0p7W1ZEIA_2zHBRW28

# true: пользователь, вошедший по e-mail, обязан добавить телефон (без кнопки «Пропустить»).
# Поставь false для разработки, пока не подключён SMS-провайдер.
EXPO_PUBLIC_REQUIRE_PHONE_FOR_EMAIL_USERS=true
