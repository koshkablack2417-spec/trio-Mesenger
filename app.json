{
  "expo": {
    "name": "Трио",
    "slug": "trio-messenger",
    "scheme": "trio",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.trio.messenger"
    },
    "android": {
      "package": "app.trio.messenger",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Трио использует фото, чтобы ты мог отправлять их в чат.",
          "cameraPermission": "Трио использует камеру для видеокружков.",
          "microphonePermission": "Трио использует микрофон для видеокружков и видео."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Трио использует контакты, чтобы ты мог отправлять их в чат."
        }
      ],
      "expo-video",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
